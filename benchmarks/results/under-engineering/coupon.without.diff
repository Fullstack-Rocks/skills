+def get_active_coupon_by_code(db: Database, code: str) -> Coupon:
+    row = db.fetch_one_by("coupons", "code", code)
+    if row is None:
+        raise LookupError(f"coupon {code!r} not found")
+    coupon = Coupon(**row)
+    if not coupon.active:
+        raise ValueError(f"coupon {code!r} is not active")
+    return coupon
