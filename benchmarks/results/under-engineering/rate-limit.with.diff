diff --git a/app/api/order_routes.py b/app/api/order_routes.py
index 3fefd1c..e7bd6a1 100644
--- a/app/api/order_routes.py
+++ b/app/api/order_routes.py
@@ -2,16 +2,23 @@ from app.db import get_db
 from app.http import Request, Response, route
 from app.services import order_service
 
+TOO_MANY_REQUESTS = Response.json({"error": "rate limit exceeded"}, status=429)
+
 
 @route("GET", "/orders/{id}")
 def show_order(request: Request) -> Response:
     order = order_service.get_order(get_db(), int(request.params["id"]))
+    if order_service.over_rate_limit(order.customer_id):
+        return TOO_MANY_REQUESTS
     return Response.json(order.__dict__)
 
 
 @route("POST", "/orders")
 def create_order(request: Request) -> Response:
-    order = order_service.create_order(get_db(), request.json())
+    data = request.json()
+    if order_service.over_rate_limit(data.get("customer_id")):
+        return TOO_MANY_REQUESTS
+    order = order_service.create_order(get_db(), data)
     return Response.json(order.__dict__, status=201)
 
 
@@ -20,4 +27,6 @@ def pay_order(request: Request) -> Response:
     import os
     api_key = os.getenv("PAYMENTS_API_KEY")
     order = order_service.get_order(get_db(), int(request.params["id"]))
+    if order_service.over_rate_limit(order.customer_id):
+        return TOO_MANY_REQUESTS
     return Response.json({"order": order.id, "charged": bool(api_key)})
diff --git a/app/services/order_service.py b/app/services/order_service.py
index de0333d..57a12cd 100644
--- a/app/services/order_service.py
+++ b/app/services/order_service.py
@@ -1,6 +1,20 @@
+import time
+
 from app.db import Database
 from app.models.order import Order
 
+RATE_LIMIT_PER_MINUTE = 100
+_request_counts: dict[int | None, tuple[int, int]] = {}  # customer_id -> (minute, requests in that minute)
+
+
+def over_rate_limit(customer_id: int | None) -> bool:
+    minute = int(time.time() // 60)
+    window_minute, count = _request_counts.get(customer_id, (minute, 0))
+    if window_minute != minute:
+        count = 0
+    _request_counts[customer_id] = (minute, count + 1)
+    return count >= RATE_LIMIT_PER_MINUTE
+
 
 def get_order(db: Database, order_id: int) -> Order:
     row = db.fetch_one("orders", order_id)
